# Copie para .env.local e ajuste. Variáveis NEXT_PUBLIC_ entram no build:
# mudou o valor, rode o npm run build de novo.

# Endereço do app dos produtores (front-app). Usado pelo botão "Acessar o app".
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend, lido só no servidor (rotas /api e fotos em /uploads)
BACKEND_URL=http://localhost:8080
