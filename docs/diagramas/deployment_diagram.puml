@startuml

' =========================================================
' CONFIGURAÇÕES VISUAIS
' =========================================================

title SISTEMA SEMENTE LIVRE\nDIAGRAMA DE IMPLANTAÇÃO UML\nARQUITETURA SUPABASE + SQL

top to bottom direction
scale max 2200 width

skinparam dpi 180
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam node {
    BackgroundColor #F8F8F8
    BorderColor #333333
}

skinparam database {
    BackgroundColor #FFF8DC
}

skinparam cloud {
    BackgroundColor #EEF7FF
}

skinparam component {
    BackgroundColor #FFFFFF
}

' =========================================================
' ATORES
' =========================================================

actor "Produtor Rural" as Produtor
actor "Administrador do Sistema" as Admin
actor "Usuário Visitante" as Visitante

' =========================================================
' CLIENTE MOBILE
' =========================================================

node "Dispositivo Mobile Android\n<<device>>" as Android {

    artifact "SementeLivre.apk\n<<artifact>>" as APK

    node "React Native Runtime\n<<executionEnvironment>>" as RNRuntime {

        component "Views Mobile" as MViews
        component "Controllers Mobile" as MControllers
        component "Models Mobile" as MModels

        component "DAO Local" as MDAO
        component "REST Services" as MServices

        database "SQLite Local Cache\n<<database>>" as SQLite

        component "Módulo Offline" as Offline
        component "Sincronização Automática" as Sync
        component "Gerenciamento Sessão" as Session
        component "Push Notifications" as Push
        component "Exportação PDF/CSV" as Export

    }

}

' =========================================================
' CLIENTE WEB
' =========================================================

node "Cliente Web Desktop\n<<device>>" as Desktop {

    artifact "Frontend React.js\n<<artifact>>" as ReactWeb

    node "Browser Runtime\n<<executionEnvironment>>" as Browser {

        component "Interface Web" as WebUI
        component "Controllers Web" as WebController
        component "Services API" as WebServices
        component "Sessão Web" as WebSession

    }

}

' =========================================================
' INTERNET
' =========================================================

cloud "Internet\nHTTPS / SSL-TLS" as Internet

' =========================================================
' INFRAESTRUTURA SUPABASE
' =========================================================

cloud "Supabase Cloud Platform\n<<cloud>>" as Supabase {

    ' =====================================================
    ' AUTENTICAÇÃO
    ' =====================================================

    node "Supabase Auth\n<<service>>" as Auth {

        artifact "JWT Tokens"
        artifact "Controle Sessão"
        artifact "OAuth2"
        artifact "Row Level Security"

    }

    ' =====================================================
    ' BANCO SQL
    ' =====================================================

    database "PostgreSQL Database\n<<database>>" as PostgreSQL {

        artifact "Tabela Usuarios"
        artifact "Tabela Produtos"
        artifact "Tabela Estoque"
        artifact "Tabela Pedidos"
        artifact "Tabela Comunidades"
        artifact "Tabela Mensagens"
        artifact "Tabela Relatorios"
        artifact "Tabela Logs"

    }

    ' =====================================================
    ' STORAGE
    ' =====================================================

    folder "Supabase Storage\n<<storage>>" as Storage {

        artifact "Fotos Produtos"
        artifact "Imagens Perfil"
        artifact "Arquivos PDF"
        artifact "Arquivos CSV"
        artifact "Documentos"

    }

    ' =====================================================
    ' EDGE FUNCTIONS
    ' =====================================================

    node "Supabase Edge Functions\n<<executionEnvironment>>" as Functions {

        component "API Produtos"
        component "API Pedidos"
        component "API Usuários"
        component "API Comunidades"
        component "API Relatórios"
        component "API Mensagens"

        component "Regras Negócio"
        component "Validação Dados"
        component "Logs Sistema"
        component "Controle Transacional"

    }

    ' =====================================================
    ' REALTIME
    ' =====================================================

    node "Supabase Realtime\n<<service>>" as Realtime {

        artifact "WebSocket Channels"
        artifact "Atualização Tempo Real"
        artifact "Eventos Banco"

    }

    ' =====================================================
    ' API GATEWAY
    ' =====================================================

    node "Supabase REST API\n<<server>>" as API {

        artifact "REST Endpoints"
        artifact "PostgREST"
        artifact "HTTPS API"

    }

}

' =========================================================
' SERVIDOR RELATÓRIOS
' =========================================================

node "Servidor Relatórios\n<<server>>" as ReportServer {

    node "Node.js Runtime\n<<executionEnvironment>>" as NodeRuntime {

        component "Gerador PDF"
        component "Gerador CSV"
        component "Exportador Dados"
        component "Compilador Relatórios"

    }

}

' =========================================================
' BACKUP
' =========================================================

database "Servidor Backup SQL\n<<database>>" as Backup {

    artifact "Backup PostgreSQL"
    artifact "Backup Diário"
    artifact "Recuperação Desastres"
    artifact "Logs Auditoria"

}

' =========================================================
' MONITORAMENTO
' =========================================================

node "Servidor Monitoramento\n<<server>>" as Monitor {

    component "Monitoramento Uptime"
    component "Monitoramento SQL"
    component "Monitoramento Performance"
    component "Monitoramento Bugs"
    component "Logs Aplicação"
    component "Logs Segurança"

}

' =========================================================
' CONEXÕES DOS USUÁRIOS
' =========================================================

Produtor --> Android : Utiliza Aplicação Mobile
Admin --> Desktop : Administração Sistema
Visitante --> Desktop : Acesso Web

' =========================================================
' CONEXÕES INTERNET
' =========================================================

Android --> Internet : HTTPS / REST API
Desktop --> Internet : HTTPS / REST API

' =========================================================
' CONEXÕES SUPABASE
' =========================================================

Internet --> Auth : OAuth2 / JWT
Internet --> PostgreSQL : SQL Queries
Internet --> Storage : Upload/Download
Internet --> Functions : HTTPS API
Internet --> API : REST API
Internet --> Realtime : WebSocket

' =========================================================
' CONEXÕES INTERNAS
' =========================================================

Functions --> PostgreSQL : SQL Transactions
Functions --> Storage : Arquivos
Functions --> Backup : Backup Automático
Functions --> Monitor : Logs + Métricas

Auth --> PostgreSQL : Controle Usuários

Realtime --> PostgreSQL : Escuta Eventos

API --> PostgreSQL : Consultas SQL

' =========================================================
' RELATÓRIOS
' =========================================================

ReportServer --> PostgreSQL : SELECT SQL
ReportServer --> Storage : Armazena PDFs

Export --> ReportServer : Solicita Relatórios

' =========================================================
' SINCRONIZAÇÃO OFFLINE
' =========================================================

SQLite --> Offline : Persistência Local
Offline --> Sync : Dados Offline
Sync --> PostgreSQL : Sincronização SQL

' =========================================================
' OBSERVAÇÕES TÉCNICAS
' =========================================================

note right of Android

ANDROID CLIENT

• React Native + TypeScript
• SQLite Offline
• Cache Persistente
• Execução Offline
• HTTPS Seguro
• Push Notifications
• Sincronização SQL

end note

note right of Desktop

WEB CLIENT

• React.js
• Browser Runtime
• HTTPS/TLS
• Interface Responsiva
• Administração Sistema

end note

note right of Supabase

SUPABASE CLOUD PLATFORM

• PostgreSQL SQL Database
• Row Level Security (RLS)
• REST API Automática
• Realtime WebSocket
• Edge Functions
• Escalabilidade Horizontal
• Cloud Native

end note

note bottom of PostgreSQL

BANCO DE DADOS SQL

• PostgreSQL Relacional
• Integridade Referencial
• Chaves Estrangeiras
• Constraints
• Transactions ACID
• Índices SQL
• Procedures e Views

end note

note bottom of Backup

POLÍTICAS BACKUP

• Backup Diário PostgreSQL
• Recuperação Desastres
• Logs Auditoria
• Integridade Relacional
• Disponibilidade >= 99.5%

end note

note bottom of Monitor

MONITORAMENTO

• Monitoramento Queries SQL
• Logs Segurança
• Rastreamento Bugs
• Métricas Sistema
• Uptime Infrastructure

end note

@enduml
